{% liquid
  case section.settings.side_column_width
    when 'narrow'
      assign iwsg_side = 'minmax(0, 0.7fr)'
    when 'medium'
      assign iwsg_side = 'minmax(0, 1fr)'
    when 'wide'
      assign iwsg_side = 'minmax(0, 1.2fr)'
    else
      assign iwsg_side = 'minmax(0, 1.4fr)'
  endcase

  case section.settings.center_column_width
    when 'narrow'
      assign iwsg_center = 'minmax(0, 240px)'
    when 'medium'
      assign iwsg_center = 'minmax(0, 360px)'
    when 'wide'
      assign iwsg_center = 'minmax(0, 520px)'
    else
      assign iwsg_center = 'minmax(0, 1.75fr)'
  endcase

  assign iwsg_mobile_class = ''
  if section.settings.mobile_image_first
    assign iwsg_mobile_class = ' image-with-side-groups--mobile-image-first'
  endif

  assign iwsg_narrow_page_class = ''
  if section.settings.narrow_page_width
    assign iwsg_narrow_page_class = ' narrow-page-width'
  endif
%}

{% capture children %}
  <div
    class="image-with-side-groups{{ iwsg_mobile_class }}{{ iwsg_narrow_page_class }}"
    style="
      --iwsg-gap: {{ section.settings.column_gap }}px;
      --iwsg-side: {{ iwsg_side }};
      --iwsg-center: {{ iwsg_center }};
      --iwsg-align-items: {{ section.settings.grid_align_items }};
    "
  >
    <div class="image-with-side-groups__side image-with-side-groups__side--left">
      {% content_for 'block', type: 'group', id: 'left' %}
    </div>
    <div class="image-with-side-groups__media">
      {% content_for 'block', type: '_media-without-appearance', id: 'media' %}
    </div>
    <div class="image-with-side-groups__side image-with-side-groups__side--right">
      {% content_for 'block', type: 'group', id: 'right' %}
    </div>
  </div>
{% endcapture %}

{% render 'section', section: section, children: children %}

{% stylesheet %}
  .image-with-side-groups {
    display: grid;
    gap: var(--iwsg-gap);
    grid-template-columns: var(--iwsg-side) var(--iwsg-center) var(--iwsg-side);
    align-items: var(--iwsg-align-items, center);
    width: 100%;
  }

  .image-with-side-groups__media {
    min-width: 0;
  }

  .image-with-side-groups__media .media-block__media {
    position: relative;
  }

  .image-with-side-groups__media .media-block {
    width: 100%;
  }

  .image-with-side-groups__side {
    min-width: 0;
  }

  .narrow-page-width {
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (max-width: 749px) { 
    .image-with-side-groups {
      grid-template-columns: 1fr;
    }

    .image-with-side-groups--mobile-image-first .image-with-side-groups__side--left {
      order: 2;
    }

    .image-with-side-groups--mobile-image-first .image-with-side-groups__media {
      order: 1;
    }

    .image-with-side-groups--mobile-image-first .image-with-side-groups__side--right {
      order: 3;
    }
  }
{% endstylesheet %}

