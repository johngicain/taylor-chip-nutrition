{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% liquid
  assign desktop_image = block_settings.desktop_side_image
  assign desktop_image_position = block_settings.desktop_image_position | default: 'before'
%}

{% capture button_markup %}
<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {{ block_settings.label }}
</a>
{% endcapture %}

{% if desktop_image != blank %}
  <div class="button-block button-block--{{ block.id }} button-block--with-desktop-image">
    {% if desktop_image_position == 'after' %}
      {{ button_markup }}
      <div class="button-block__desktop-image" aria-hidden="true">
        {{ desktop_image | image_url: width: 400 | image_tag: class: 'button-block__desktop-image-img', loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 750px) 200px, 1px' }}
      </div>
    {% else %}
      <div class="button-block__desktop-image" aria-hidden="true">
        {{ desktop_image | image_url: width: 400 | image_tag: class: 'button-block__desktop-image-img', loading: 'lazy', widths: '200, 300, 400', sizes: '(min-width: 750px) 200px, 1px' }}
      </div>
      {{ button_markup }}
    {% endif %}
  </div>
{% else %}
  {{ button_markup }}
{% endif %}

{% stylesheet %}
  .link {
    text-decoration: none;
    text-decoration-color: currentcolor;

    &:hover {
      color: var(--color-primary-hover);
      text-decoration-color: transparent;
    }
  }

  .button-block--with-desktop-image {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--gap-sm);
    max-width: 100%;
  }

  .button-block__desktop-image {
    position: absolute;
    display: none;
    flex-shrink: 0;
  }

  @media screen and (min-width: 750px) {
    .button-block__desktop-image {
      display: block;
    }

    .button-block__desktop-image-img {
      display: block;
      width: auto;
      max-width: min(200px, 100%);
      height: auto;
      max-height: 5rem;
      object-fit: contain;
    }
  }
{% endstylesheet %}
